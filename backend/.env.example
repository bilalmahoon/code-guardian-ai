APP_NAME="CodeGuardian AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Database ────────────────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=codeguardian
DB_USERNAME=codeguardian
DB_PASSWORD=secret

# ─── Cache & Queue ───────────────────────────────────────────────────────────
BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=secret
REDIS_CLIENT=phpredis

# ─── Mail ────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@codeguardian.ai"
MAIL_FROM_NAME="${APP_NAME}"

# ─── MinIO / S3 Storage ───────────────────────────────────────────────────────
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=codeguardian
AWS_SECRET_ACCESS_KEY=secretkey123
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=codeguardian
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# ─── AI Providers ────────────────────────────────────────────────────────────
AI_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

GEMINI_API_KEY=...
GEMINI_MODEL=gemini-1.5-pro

AI_MAX_TOKENS=8192
AI_TEMPERATURE=0.1

# ─── OAuth — GitHub ──────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI="${APP_URL}/api/v1/auth/oauth/github/callback"

# ─── OAuth — Google ──────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/v1/auth/oauth/google/callback"

# ─── Repository Integrations ──────────────────────────────────────────────────
BITBUCKET_CLIENT_ID=
BITBUCKET_CLIENT_SECRET=
BITBUCKET_REDIRECT_URI="${APP_URL}/api/v1/repositories/bitbucket/callback"

GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_WEBHOOK_SECRET=

GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_REDIRECT_URI="${APP_URL}/api/v1/repositories/gitlab/callback"

# ─── Sanctum ─────────────────────────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1

# ─── Spatie Permissions ───────────────────────────────────────────────────────
# Config published via: php artisan vendor:publish --provider="Spatie\Permission\PermissionServiceProvider"

# ─── Test Isolation ───────────────────────────────────────────────────────────
TEST_RUNNER_TIMEOUT=120
TEST_RUNNER_MAX_MEMORY=256
